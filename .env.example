# Copy to .env when you need to override the JSON config.
# Shell variables win over .env, and both win over config files.

ENV=local
APP_ID=indore

# Optional URL overrides. Leave unset to use config/environments/<ENV>.json.
# Local product (dashboard + API must already be running):
BASE_URL=http://localhost:5173/login
API_BASE_URL=http://localhost:5173
#
# MPPKVVCL Indore QA (the live API has no /indore path prefix; qa.json strips it):
# BASE_URL=https://mdm.mppkvvcl.bestinfra.app
# API_BASE_URL=https://api.mdm.mppkvvcl.bestinfra.app

# Names of these variables are declared in config/apps/indore.json under "keys".
INDORE_API_KEY=
EMAIL=
PASSWORD=
