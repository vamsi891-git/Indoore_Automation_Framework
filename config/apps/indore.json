{
  "id": "indore",
  "name": "Indore MDMS",
  "schemaDir": "apps/indore/schemas",
  "routes": {
    "login": "/login",
    "consumers": "/consumers",
    "dashboard": "/dashboard",
    "dtrDashboard": "/dtr/dashboard",
    "consumerData": "/master-data/consumers",
    "meterData": "/master-data/meters",
    "meterAdd": "/master-data/meters/add-meter",
    "dtrData": "/master-data/dtrs",
    "consumerAdd": "/master-data/consumers/add-consumer",
    "dtrAdd": "/master-data/dtrs/add-dtr",
    "activityLogs": "/master-data/audit-logs"
  },
  "endpoints": {
    "login": "indore/auth/login",
    "me": "indore/auth/me",
    "dtrs": "indore/asset-management/dtrs",
    "dtrById": "indore/asset-management/dtrs/{id}",
    "metrics": "indore/dashboard/overall-metrics",
    "communicationTrend": "indore/mis-dashboard/communication-trend",
    "energyLossTrends": "indore/energy-audit/loss-analysis-trends",
    "networkHierarchy": "indore/asset-management/network-hierarchy",
    "organisationHierarchy": "indore/asset-management/organisation-hierarchy",
    "consumerMetrics": "dashboard/consumer/metrics",
    "consumerMeterStatus": "dashboard/consumer/meter-status",
    "consumerMasterData": "master-data/consumer-master-data",
    "utilsHierarchies": "utils/hierarchies/{kind}",
    "utilsSearchOrganisations": "utils/search/organisations",
    "utilsSearchNetworks": "utils/search/networks",
    "utilsMeterPhases": "utils/meter-phases",
    "utilsConnectionStatuses": "utils/connection-statuses",
    "utilsConsumerCategories": "utils/consumer-categories",
    "utilsDeviceManufacturers": "utils/device-manufacturers",
    "utilsPaymentContracts": "utils/payment-contracts",
    "utilsTimeOfDays": "utils/time-of-days",
    "utilsScopeAnchor": "utils/scope-anchor/{kind}",
    "metersData": "meters-data",
    "meterBulkTemplate": "master-data/bulk-upload-meters/template",
    "meterBulkUpload": "master-data/bulk-upload-meters",
    "dtrMasterData": "master-data/dtr-master-data",
    "dtrBulkTemplate": "master-data/bulk-upload-dtr/template",
    "dtrBulkUpload": "master-data/bulk-upload-dtr",
    "masterDataAuditLogs": "master-data/audit-logs",
    "authRefresh": "auth/refresh",
     "permissionRoles": "permissions/roles",
    "userById": "users/{id}",
    "notificationStats": "notifications/stats",
    "auth2faDevices": "auth/2fa/devices",
    "meterCommunicationStatus": "master-data/meter-communication-status",
    "authMe": "auth/me",
    "myPermissions": "permissions/me/permissions",
    "myPermissionModules": "permissions/me/modules",
    "ledgerTemplate": "master-data/ledger/template",
    "ledgerValidate": "master-data/ledger/validate",
    "consumerMasterExport": "master-data/export",
    "consumerCategoryDistribution": "dashboard/consumer/category-distribution",
    "consumerConnectionStatus": "dashboard/consumer/connection-status",
    "consumerPhaseDistribution": "dashboard/consumer/phase-distribution",
    "consumerOemDistribution": "dashboard/consumer/oem-distribution",
    "dtrSummary": "dashboard/dtr/summary",
    "dtrPowerStatus": "dashboard/dtr/power-status",
    "dtrConsumption": "dashboard/dtr/consumption",
    "dtrCommunicationStatus": "dashboard/dtr/communication-status",
    "dtrPercentageLoading": "dashboard/dtr/percentage-loading",
    "dtrLoadUnbalance": "dashboard/dtr/load-unbalance",
    "dtrVoltageUnbalance": "dashboard/dtr/voltage-unbalance",
    "dtrPowerStatusDetails": "dashboard/dtr/power-status-details",
    "dtrCommunicationDetails": "dashboard/dtr/communication-details",
    "dtrPercentageLoadingDetails": "dashboard/dtr/percentage-loading-details",
    "dtrLoadUnbalanceDetails": "dashboard/dtr/load-unbalance-details",
    "dtrVoltageUnbalanceDetails": "dashboard/dtr/voltage-unbalance-details"
  },
  "keys": {
    "apiKey": "INDORE_API_KEY",
    "email": "EMAIL",
    "adminPassword": "PASSWORD"
  },
  "headers": {
    "Accept": "application/json"
  },
  "auth": {
    "apiKeyHeader": "x-api-key",
    "tokenScheme": "Bearer"
  },
  "storage": {
    "authToken": "authToken"
  },
  "features": {
    "charts": true,
    "assets": true,
    "dashboard": true
  },
  "ui": {
    "elements": {
      "email": { "method": "findByRole", "role": "textbox", "name": "Email Address" },
      "password": { "method": "findByRole", "role": "textbox", "name": "Password" },
      "captcha": { "method": "findByRole", "role": "textbox", "name": "Captcha" },
      "loginSubmit": { "method": "findByRole", "role": "button", "name": "Login" },
      "loginError": { "method": "findByRole", "role": "alert" },
      "pageTitle": { "method": "findByText", "text": "Dashboard Overview" },
      "consumersTab": { "method": "findByRole", "role": "tab", "name": "Consumers" },
      "consumerOverview": { "method": "findByText", "text": "Consumer Overview" },
      "consumerPeriod": { "method": "findByRole", "role": "button", "name": "Consumer dashboard month and year" },
      "consumersChart": { "method": "findByRole", "role": "link", "name": "Active consumers", "exact": false },
      "netMeteringChart": { "method": "findByRole", "role": "link", "name": "Net Metering Consumers", "exact": false },
      "updateKpis": { "method": "findByRole", "role": "button", "name": "Update KPIs" },
      "substationsCard": { "method": "findByRole", "role": "link", "name": "Substations", "exact": false },
      "feedersCard": { "method": "findByRole", "role": "link", "name": "Feeders", "exact": false },
      "dtrsCard": { "method": "findByRole", "role": "link", "name": "DTRs", "exact": false },
      "consumersCard": { "method": "findByRole", "role": "link", "name": "Consumers", "exact": false },
      "assetMap": { "method": "findByRole", "role": "region", "name": "Asset location map" },
      "mapSearch": { "method": "findByRole", "role": "textbox", "name": "Search on the map" },
      "appNav": { "method": "findByRole", "role": "navigation", "name": "Primary" },
      "navDashboard": { "method": "findByRole", "role": "link", "name": "Dashboard" },
      "navDtrs": { "method": "findByRole", "role": "link", "name": "DTRs" },
      "dtrTable": { "method": "findByTestId", "testId": "dtr-table" },
      "communicationChart": { "method": "findByRole", "role": "region", "name": "Communication trend" },
      "energyLossChart": { "method": "findByRole", "role": "region", "name": "Energy loss trend" }
    }
  },
  "execution": {
    "webBrowsers": ["chromium"],
    "e2eBrowsers": ["chromium"]
  }
}
